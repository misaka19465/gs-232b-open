CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# NOTE: 手动 USB 恢复采用单应用布局；保留 NVS，给完整固件预留 3MiB。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# NOTE: STA 支持 WPA/WPA2 PSK 与 WPA3 SAE（HnP/H2E）；配网热点仍用 WPA2。
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
CONFIG_ESP_WIFI_ENABLE_SAE_H2E=y
CONFIG_ESP_WIFI_WPA3_COMPATIBLE_SUPPORT=y
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP is not set
# CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT is not set
# NOTE: 无 PSRAM 的 C3 同时运行 UART/ETH/WS；默认 10 个 RX buffer 加 RX IRAM
# 优化会耗尽 SoftAP 启动堆。保留与 BA 窗口相等的 6 个 RX buffer，释放 RX IRAM 给 SAE。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# NOTE: GPIO6/7 的 UART1 专用于协议，GPIO20 专用于 SPEED_PWM；
# 所有应用/引导日志走原生 USB Serial/JTAG，禁止 UART 控制台和次级镜像。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# CONFIG_HTTPD_QUEUE_WORK_BLOCKING is not set
