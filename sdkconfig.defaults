CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# NOTE: 完整网络与管理路径使用 IDF 标准尺寸优化，保持既有 1MiB 应用分区。
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# NOTE: GPIO6/7 的 UART1 专用于协议，GPIO20 专用于 SPEED_PWM；
# 所有应用/引导日志走原生 USB Serial/JTAG，禁止 UART 控制台和次级镜像。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# CONFIG_HTTPD_QUEUE_WORK_BLOCKING is not set
